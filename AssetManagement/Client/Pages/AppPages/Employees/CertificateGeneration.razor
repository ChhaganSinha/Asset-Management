@page "/certificate-generation"
@using AssetManagement.Client.Client
@using AssetManagement.Client.Shared
@using AssetManagement.Dto.Models
@using Microsoft.AspNetCore.Authorization
@inject AppClient client
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<Breadcrumb Items="breadcrumbItems" />

<div class="card shadow-sm" style="height:80vh;">
    <div class="card-body">
        <h5 class="card-title mb-4">Certificate Generation</h5>

        <UiAlert Model="alert" />

        @if (isLoading)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else
        {
            <EditForm Model="formModel" OnValidSubmit="GenerateCertificate">
                <DataAnnotationsValidator />
                <ValidationSummary class="mb-3" />

                <!-- Employee & Letter Type -->
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold required-field">
                            Employee
                        </label>
                        <DropdownSelect @bind-Value="formModel.EmployeeId"
                                        DataSource="employeeDropdown"
                                        EventDropdown="OnEmployeeChanged"
                                        EmptyText="-- Select Employee --"
                                        Css="form-select" />
                        <ValidationMessage For="() => formModel.EmployeeId" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold required-field">
                            Letter Type
                        </label>

                        <InputRadioGroup @bind-Value="formModel.CertificateType"
                                         class="d-flex flex-wrap gap-4 mt-2">

                            <div class="form-check">
                                <InputRadio class="form-check-input"
                                            Value="CertificateType.Experience" />
                                <label class="form-check-label">
                                    Experience Certificate
                                </label>
                            </div>

                            <div class="form-check">
                                <InputRadio class="form-check-input"
                                            Value="CertificateType.Relieving" />
                                <label class="form-check-label">
                                    Relieving Letter
                                </label>
                            </div>

                        </InputRadioGroup>
                    </div>
                
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">
                            Title
                        </label>
                        <InputSelect class="form-select" @bind-Value="formModel.Title">
                            @foreach (var title in titleOptions)
                            {
                                <option value="@title">@title</option>
                            }
                        </InputSelect>
                    </div>

                </div>

                <!-- Action Button -->
                <div class="d-flex justify-content-end mt-4">
                    <button class="btn btn-primary px-4"
                            type="submit"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            
                                        }
                        else
                        {
                            <i class="bi bi-download me-1">Generate & Download</i>
                            
                                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>


@code {
    private readonly List<ClientBreadcrumbItem> breadcrumbItems = new()
    {
        new ClientBreadcrumbItem { Text = "Home", Url = "/" },
        new ClientBreadcrumbItem { Text = "Certificate Generation", IsActive = true }
    };

    private readonly List<string> titleOptions = new() { "Mr.", "Ms.", "Mrs.", "Mx." };

    private readonly List<PronounOption> pronounOptions = new()
    {
        new("He", "He/Him/His", "He", "Him", "His"),
        new("She", "She/Her/Her", "She", "Her", "Her"),
        new("They", "They/Them/Their", "They", "Them", "Their")
    };

    private readonly AlertModel alert = new();
    private CertificateGenerationRequest formModel = new();
    private List<Employee> employees = new();
    private List<KeyValuePair<string, string>> employeeDropdown = new();
    private string selectedEmployeeName = string.Empty;
    private string selectedEmployeeDesignation = string.Empty;
    private string selectedPronoun = "He";
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employees = (await client.GetAllEmployee())?.OrderBy(e => e.EmployeeName).Where(o=>o.Status==EmployeeStatus.Resigned).ToList() ?? new List<Employee>();
            employeeDropdown = employees
                .Select(e => new KeyValuePair<string, string>(e.Id.ToString(), $"{e.EmployeeName} (EmpID: {e.EmployeeId})"))
                .ToList();
            ApplyPronouns(selectedPronoun);
        }
        catch
        {
            alert.SetError("Failed to load company or employee data.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnEmployeeChanged(string value)
    {
        if (!int.TryParse(value, out var employeeId))
        {
            selectedEmployeeName = string.Empty;
            selectedEmployeeDesignation = string.Empty;
            return;
        }

        var selectedEmployee = employees.FirstOrDefault(e => e.Id == employeeId);
        selectedEmployeeName = selectedEmployee?.EmployeeName ?? string.Empty;
        selectedEmployeeDesignation = selectedEmployee?.Designation ?? string.Empty;
        formModel.SignerName = selectedEmployee.EmployeeName;
        formModel.SignerDesignation = selectedEmployee.Designation;
    }

    private void OnPronounChanged(ChangeEventArgs args)
    {
        selectedPronoun = args?.Value?.ToString() ?? "He";
        ApplyPronouns(selectedPronoun);
    }

    private void ApplyPronouns(string key)
    {
        var option = pronounOptions.FirstOrDefault(p => p.Key == key) ?? pronounOptions.First();
        formModel.HeShe = option.HeShe;
        formModel.HimHer = option.HimHer;
        formModel.HisHer = option.HisHer;
    }

    private async Task GenerateCertificate()
    {
        alert.Clear();
        isSubmitting = true;

        try
        {
            var response = await client.GenerateCertificateAsync(formModel);
            if (response?.FileContent == null || response.FileContent.Length == 0)
            {
                alert.SetError("Certificate generation failed. Please try again.");
                return;
            }

            await JSRuntime.InvokeVoidAsync("downloadFile", response.FileName, response.ContentType, response.FileContent);
            alert.SetSuccess("Certificate generated successfully.");
        }
        catch
        {
            alert.SetError("Failed to generate certificate.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed record PronounOption(string Key, string Label, string HeShe, string HimHer, string HisHer);
}
