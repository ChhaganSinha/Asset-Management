@page "/reports"
@page "/report/{Id:int}"

@using AssetManagement.Client.Client
@using AssetManagement.Client.Pages.GridComponent
@using AssetManagement.Client.Shared.Popup
@using AssetManagement.Dto.Models
@using AssetManagement.Dto
@using MudBlazor
@inject AppClient client
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@attribute [Authorize]

<Breadcrumb Items="breadcrumbItems" />

<div class="report-form">

    <!-- HEADER -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h4 class="page-title mb-0">Reports</h4>
            <div class="text-muted small">Generate Employee & Asset insights with filters</div>
        </div>

        <!-- PILL TABS -->
        <div class="btn-group shadow-xs" role="tablist" aria-label="Report type">
            <button class="btn btn-pill @(SelectedOption == "Employeebtn" ? "btn-primary" : "btn-outline-primary")"
                    type="button" role="tab" aria-selected="@(SelectedOption == "Employeebtn")"
                    @onclick="SwitchToEmployee">
                Employee
            </button>
            <button class="btn btn-pill @(SelectedOption == "Assetbtn" ? "btn-primary" : "btn-outline-primary")"
                    type="button" role="tab" aria-selected="@(SelectedOption == "Assetbtn")"
                    @onclick="SwitchToAsset">
                Asset
            </button>
        </div>
    </div>

    <!-- FILTERS CARD -->
    <div class="card card-elev border-0">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <h5 class="m-0">Filters</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-soft-primary" title="View" @onclick="ViewReportData">
                    View
                </button>
                <button type="button" class="btn btn-soft-secondary" title="Clear"
                        @onclick="@(SelectedOption == "Employeebtn" ? ClearFilter : ClearAssetFilter)">
                    Clear
                </button>
            </div>
        </div>

        <div class="card-body">
            @if (SelectedOption == "Employeebtn")
            {
                <EditForm Model="employeeModel">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Company</label>
                            <DropdownSelect T="string" @bind-Value="selectedSourceCompanyCode"
                                            DataSource="CompanyDropdown" EmptyText="-- Select Company --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Job Profile</label>
                            <DropdownSelect T="string" @bind-Value="selectedJobProfile"
                                            DataSource="JobProfileDropdown" EmptyText="-- Select --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Manager</label>
                            <DropdownSelect T="string" @bind-Value="selectedManager"
                                            DataSource="ManagerDropdown" EmptyText="-- Select --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Office Branch</label>
                            <DropdownSelect T="string" @bind-Value="selectedBranch"
                                            DataSource="BranchDropdown" EmptyText="-- Select --" Css="form-select" />
                        </div>

                        <!-- Status -->
                        <div class="col-12">
                            <label class="form-label fw-semibold me-3">Status</label>
                            <div class="status-group">
                                <InputRadioGroup @bind-Value="selectedEmployeeStatus">
                                    <div class="d-flex flex-wrap gap-3">
                                        <label class="form-check form-check-inline">
                                            <InputRadio class="form-check-input" Value="@("All")" />
                                            <span class="form-check-label">All</span>
                                        </label>
                                        <label class="form-check form-check-inline">
                                            <InputRadio class="form-check-input" Value="@("Active")" />
                                            <span class="form-check-label">Active</span>
                                        </label>
                                        <label class="form-check form-check-inline">
                                            <InputRadio class="form-check-input" Value="@("Resigned")" />
                                            <span class="form-check-label">Resigned</span>
                                        </label>
                                    </div>
                                </InputRadioGroup>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="form-label fw-semibold">Skills</label>
                            <HxMultiSelect TItem="string" TValue="string" Data="SkillOptions"
                                           Value="@selectedSkills" ValueChanged="OnSkillsChanged"
                                           ValueExpression="@(() => selectedSkills)"
                                           TextSelector="@(s => s)" ValueSelector="@(s => s)"
                                           EmptyText="- select -" NullDataText="Loading..." />
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input" id="multiTextChoice" @bind-Value="multiselectionTextChoice" />
                                <label class="form-check-label" for="multiTextChoice">MultiSelection Text choice</label>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="form-label fw-semibold">Join Date</label>
                            <div class="input-group input-dates">
                                <input type="date" class="form-control" @bind="joinDateStart" />
                                <span class="input-group-text">to</span>
                                <input type="date" class="form-control" @bind="joinDateEnd" />
                            </div>
                        </div>

                        @if (selectedEmployeeStatus == "Resigned")
                        {
                            <div class="col-12 col-lg-4">
                                <label class="form-label fw-semibold">Resign Date</label>
                                <div class="input-group input-dates">
                                    <input type="date" class="form-control" @bind="resignDateStart" />
                                    <span class="input-group-text">to</span>
                                    <input type="date" class="form-control" @bind="resignDateEnd" />
                                </div>
                            </div>
                        }
                    </div>
                </EditForm>
            }
            else if (SelectedOption == "Assetbtn")
            {
                <EditForm Model="employeeModel">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Company</label>
                            <DropdownSelect T="string" @bind-Value="selectedSourceCompanyForAssetCode"
                                            DataSource="CompanyDropdown" EmptyText="-- Select Company --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Asset Type</label>
                            <DropdownSelect T="string" @bind-Value="selectedAssetType"
                                            DataSource="AssetTypeDropdown" EmptyText="-- Select --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Brand</label>
                            <DropdownSelect T="string" @bind-Value="selectedAssetBrand"
                                            DataSource="AssetBrandDropdown" EmptyText="-- Select --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Model</label>
                            <DropdownSelect T="string" @bind-Value="selectedAssetModel"
                                            DataSource="AssetModelDropdown" EmptyText="-- Select --" Css="form-select" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold">Allocation</label>
                            <InputSelect @bind-Value="allocationStatus" class="form-select">
                                <option value="All">All</option>
                                <option value="Free">Free</option>
                                <option value="Allocated">Allocated</option>
                            </InputSelect>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="form-label fw-semibold">Acquire Date</label>
                            <div class="input-group input-dates">
                                <input type="date" class="form-control" @bind="aquireDateStart" />
                                <span class="input-group-text">to</span>
                                <input type="date" class="form-control" @bind="aquireDateEnd" />
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="form-label fw-semibold">Discard Date</label>
                            <div class="input-group input-dates">
                                <input type="date" class="form-control" @bind="discardDateStart" />
                                <span class="input-group-text">to</span>
                                <input type="date" class="form-control" @bind="discardDateEnd" />
                            </div>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <!-- LOADING OVERLAY -->
    @if (isLoading)
    {
        <div class="loading-overlay">
            <div class="spinner-border" role="status" aria-label="Loading"></div>
            <div class="mt-2 small text-muted">Fetching data…</div>
        </div>
    }

    <!-- EMPLOYEE REPORT -->
    @if (showReport && SelectedOption == "Employeebtn")
    {
        <div class="card card-elev mt-3 border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="m-0">Employee Report</h6>
                    <small class="text-muted">Filtered results</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">Total: @totalItem</span>
                    <button type="button" class="btn btn-soft-primary btn-sm" @onclick="OpenExportDialog">Export</button>
                    <button type="button" class="btn btn-soft-danger btn-sm" @onclick="CloseReport">Close</button>
                </div>
            </div>

            <div class="data-scroll">
                <table id="printContent" class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th class="sticky-col">SN.</th>
                            <th>Company</th>
                            <th>EmployeeID</th>
                            <th>Status</th>
                            <th>Name</th>
                            <th>Father</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Aadhaar</th>
                            <th>PAN</th>
                            <th>UAN</th>
                            <th>Education</th>
                            <th>Skills</th>
                            <th>Designation</th>
                            <th>DOB</th>
                            <th>Manager</th>
                            <th>JoinDate</th>
                            <th>ResignDate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (responceDataOfEmployee?.Count == 0)
                        {
                            <tr>
                                <td colspan="18">
                                    <div class="empty-state">
                                        <div class="empty-title">No data found</div>
                                        <div class="empty-text">Try adjusting filters and click View again.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var counter = 0;
                            foreach (var r in responceDataOfEmployee)
                            {
                                counter++;
                                <tr>
                                    <td class="sticky-col">@counter</td>
                                    <td>@r.CompanyCode</td>
                                    <td class="text-nowrap">@r.EmployeeId</td>
                                    <td>
                                        <span class="status-chip @(r.Status == EmployeeStatus.Permanent || r.Status == EmployeeStatus.Probation || r.Status == EmployeeStatus.Temporary
                                                                              ? "chip-success"
                                                                              : r.Status == EmployeeStatus.Resigned
                                                                                  ? "chip-danger"
                                                                                  : r.Status == EmployeeStatus.Consultant
                                                                                      ? "chip-primary"
                                                                                      : "chip-secondary")">
                                @r.Status
                            </span>
                        </td>

                                    <td class="text-truncate-2" title="@r.EmployeeName">@r.EmployeeName</td>
                                    <td class="text-truncate-2" title="@r.fatherName">@r.fatherName</td>
                                    <td class="text-truncate" title="@r.EmailId">@r.EmailId</td>
                                    <td class="text-nowrap">@r.MobileNumber</td>
                                    <td class="text-nowrap">@r.AadhaarNumber</td>
                                    <td class="text-nowrap">@r.PANNumber</td>
                                    <td class="text-nowrap">@r.UANNo</td>
                                    <td class="text-truncate-2" title="@r.EmployeeEducation">@r.EmployeeEducation</td>
                                    <td class="text-truncate-2" title="@r.Skills">@r.Skills</td>
                                    <td class="text-truncate" title="@r.Designation">@r.Designation</td>
                                    <td>@r.DateOfBirth.ToString("dd/MMM/yyyy")</td>
                                    <td class="text-truncate" title="@r.ReportingTo">@r.ReportingTo</td>
                                    <td>@r.DateOfJoin.ToString("dd/MMM/yyyy")</td>
                                    <td>@(r.DateOfLeaving == default ? "" : r.DateOfLeaving.ToString("dd/MMM/yyyy"))</td>
                                </tr>
                            }
                            totalItem = counter;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ASSET REPORT -->
    @if (showReport && SelectedOption == "Assetbtn")
    {
        <div class="card card-elev mt-3 border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="m-0">Asset Report</h6>
                    <small class="text-muted">Filtered results</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">Total: @totalItem</span>
                    <button type="button" class="btn btn-soft-primary btn-sm" @onclick="OpenExportDialog">Export</button>
                    <button type="button" class="btn btn-soft-danger btn-sm" @onclick="CloseReport">Close</button>
                </div>
            </div>

            <div class="data-scroll">
                <table id="printAssetContent" class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th class="sticky-col">SN.</th>
                            <th>Company</th>
                            <th>Asset Type</th>
                            <th>Brand</th>
                            <th>Model</th>
                            <th>SerialNumber</th>
                            <th>Status</th>
                            <th>Employee Name</th>
                            <th>Employee Email</th>
                            <th>Acquire Date</th>
                            <th>Discard Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (responceDataOfAsset?.Count == 0)
                        {
                            <tr>
                                <td colspan="11">
                                    <div class="empty-state">
                                        <div class="empty-title">No data found</div>
                                        <div class="empty-text">Try adjusting filters and click View again.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var counter = 0;
                            foreach (var r in responceDataOfAsset)
                            {
                                counter++;
                                <tr>
                                    <td class="sticky-col">@counter</td>
                                    <td>@r.CompanyCode</td>
                                    <td>@r.AssetType</td>
                                    <td>@r.Brand</td>
                                    <td>@r.Model</td>
                                    <td class="text-nowrap">@r.SerialNumber</td>
                                    <td>
                                        <span class="status-chip @(r.Status == AllocationStatus.Allocated ? "chip-primary" :
                                                                             r.Status == AllocationStatus.Free ? "chip-success" :
                                                                             "chip-secondary")">
                                                                             @r.Status
                                        </span>
                                    </td>
                                    <td class="text-truncate" title="@r.EmployeeName">@r.EmployeeName</td>
                                    <td class="text-truncate" title="@r.EmployeeEmail">@r.EmployeeEmail</td>
                                    <td>@r.AcquireDate.ToString("dd/MMM/yyyy")</td>
                                    <td>@(r.DiscardDate.HasValue? r.DiscardDate.Value.ToString("dd/MMM/yyyy") : "")</td>
                                </tr>
                            }
                            totalItem = counter;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    /* --- Page polish --- */
    .page-title {
        font-weight: 700;
        letter-spacing: .2px;
    }

    .btn-pill {
        border-radius: 999px;
        padding: .5rem 1rem;
    }

    .btn-soft-primary {
        background: rgba(13,110,253,.08);
        color: #0d6efd;
        border: 1px solid rgba(13,110,253,.2);
    }

        .btn-soft-primary:hover {
            background: rgba(13,110,253,.12);
        }

    .btn-soft-secondary {
        background: rgba(108,117,125,.08);
        color: #6c757d;
        border: 1px solid rgba(108,117,125,.2);
    }

    .btn-soft-danger {
        background: rgba(220,53,69,.08);
        color: #dc3545;
        border: 1px solid rgba(220,53,69,.2);
    }

    .badge.bg-primary-subtle {
        background: rgba(13,110,253,.12) !important;
    }

    .card-elev {
        border-radius: .8rem;
        box-shadow: 0 6px 14px rgba(33,37,41,.06);
    }

    .shadow-xs {
        box-shadow: 0 2px 8px rgba(33,37,41,.06);
    }

    .input-dates .input-group-text {
        min-width: 2.25rem;
        justify-content: center;
    }

    /* --- Loading overlay --- */
    .loading-overlay {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.6);
        backdrop-filter: blur(2px);
        z-index: 1050;
    }

    /* --- Table: modern skin --- */
    .data-scroll {
        overflow: auto;
        max-height: 480px;
        border-top: 1px solid #eee;
        border-bottom-left-radius: .8rem;
        border-bottom-right-radius: .8rem;
    }

    .table-modern {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .925rem;
        white-space: nowrap;
    }

        .table-modern thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f8f9fa;
            color: #495057;
            font-weight: 700;
            border-bottom: 1px solid #e9ecef;
            box-shadow: 0 2px 0 rgba(0,0,0,.03);
        }

        /* First column sticks for easier scanning */
        .table-modern .sticky-col {
            position: sticky;
            left: 0;
            z-index: 3;
            background: #fff;
            box-shadow: 1px 0 0 rgba(0,0,0,.06);
            font-weight: 600;
        }

        .table-modern tbody tr {
            transition: background-color .15s ease, box-shadow .15s ease;
        }

            .table-modern tbody tr:hover {
                background-color: #f8faff;
            }

        .table-modern td, .table-modern th {
            padding: .65rem .75rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f3f5;
        }

    /* Truncation helpers */
    .text-truncate {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-width: 240px;
        white-space: normal;
    }

    /* Status Chips */
    .status-chip {
        display: inline-block;
        padding: .25rem .5rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        border: 1px solid transparent;
    }

    .chip-success {
        background: rgba(25,135,84,.1);
        color: #198754;
        border-color: rgba(25,135,84,.25);
    }

    .chip-danger {
        background: rgba(220,53,69,.1);
        color: #dc3545;
        border-color: rgba(220,53,69,.25);
    }

    .chip-primary {
        background: rgba(13,110,253,.1);
        color: #0d6efd;
        border-color: rgba(13,110,253,.25);
    }

    .chip-secondary {
        background: rgba(108,117,125,.1);
        color: #6c757d;
        border-color: rgba(108,117,125,.25);
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 2.25rem 1rem;
        color: #6c757d;
    }

    .empty-title {
        font-weight: 700;
    }

    .empty-text {
        font-size: .925rem;
    }

    /* Gorgeous, subtle cross-browser scrollbars for the data area */
    .data-scroll {
        scrollbar-width: thin;
        scrollbar-color: #cfd4da transparent;
    }

        .data-scroll::-webkit-scrollbar {
            height: 10px;
            width: 10px;
        }

        .data-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .data-scroll::-webkit-scrollbar-thumb {
            background-color: #cfd4da;
            border-radius: 999px;
            border: 2px solid transparent;
            background-clip: content-box;
        }

        .data-scroll:hover::-webkit-scrollbar-thumb {
            background-color: #b9bec5;
        }

    /* Small tone tweaks */
    .form-label.fw-semibold {
        margin-bottom: .35rem;
    }

    .report-form {
        padding-bottom: 1rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    // State
    private bool showReport = false;
    private int totalItem = 0;
    private bool isLoading = false;

    // Models and data
    Employee employeeModel = new();
    List<Company> company = new();
    private List<ClientBreadcrumbItem> breadcrumbItems = new();
    List<AssetType> assetType = new();
    List<Asset> asset = new();
    List<Employee> employee = new();
    List<Employee> responceDataOfEmployee = new();
    List<Asset> responceDataOfAsset = new();

    // Filters
    private DateTime? joinDateStart;
    private DateTime? joinDateEnd;
    private DateTime? resignDateStart;
    private DateTime? resignDateEnd;
    public string selectedEmployeeStatus { get; set; } = "All";

    private DateTime? aquireDateStart;
    private DateTime? aquireDateEnd;
    private DateTime? discardDateStart;
    private DateTime? discardDateEnd;
    private string allocationStatus = "All";

    // Selections
    public string SelectedOption { get; set; } = "Employeebtn";
    public string[] SkillOptions = { };
    private bool multiselectionTextChoice;
    private List<string> selectedSkills { get; set; } = new();

    // Dropdown sources
    ReportFilters reportFilters;
    AssetReportFilters assetReportFilters;

    // Dropdown bindings
    private string? selectedSourceCompanyCode { get; set; }
    private string? selectedJobProfile { get; set; }
    private string? selectedManager { get; set; }
    private string? selectedBranch { get; set; }
    private string? selectedLocation { get; set; }

    private string? selectedSourceCompanyForAssetCode { get; set; }
    private string? selectedAssetType { get; set; }
    private string? selectedAssetBrand { get; set; }
    private string? selectedAssetModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        breadcrumbItems = new()
        {
            new ClientBreadcrumbItem { Text = "Home", Url = "/" },
            new ClientBreadcrumbItem { Text = "Reports", IsActive = true }
        };

        reportFilters = await client.GetEmployeeReportFileters();
        assetReportFilters = await client.GetAssetReportFileters();

        var employeeSkills = await client.GetAllSkill();
        SkillOptions = employeeSkills.Select(skill => skill.Skill).ToArray();

        company = new List<Company>(await client.GetAllCompany());
        employee = new List<Employee>(await client.GetAllEmployee());
        asset = new List<Asset>(await client.GetAllAsset());
    }

    // Tab switch
    private void SwitchToEmployee() => SwitchTab("Employeebtn");
    private void SwitchToAsset() => SwitchTab("Assetbtn");
    private void SwitchTab(string tab)
    {
        SelectedOption = tab;
        showReport = false;
        if (tab != "Employeebtn")
        {
            resignDateStart = null;
            resignDateEnd = null;
        }
    }

    // Dropdown sources
    private List<KeyValuePair<string, string>> CompanyDropdown =>
        company.Select(c => new KeyValuePair<string, string>(c.CompanyCode, $"{c.Name} ({c.CompanyCode})")).ToList();

    private List<KeyValuePair<string, string>> JobProfileDropdown =>
        reportFilters?.Designations?.Select(d => new KeyValuePair<string, string>(d, d)).ToList() ?? new();

    private List<KeyValuePair<string, string>> ManagerDropdown =>
        reportFilters?.Managers?.Select(m => new KeyValuePair<string, string>(m, m)).ToList() ?? new();

    private List<KeyValuePair<string, string>> BranchDropdown =>
        reportFilters?.Branches?.Select(b => new KeyValuePair<string, string>(b, b)).ToList() ?? new();

    private List<KeyValuePair<string, string>> AssetTypeDropdown =>
        string.IsNullOrEmpty(selectedSourceCompanyForAssetCode)
            ? new()
            : assetReportFilters.AssetType
                .Where(o => o.CompanyCode == selectedSourceCompanyForAssetCode)
                .Select(a => new KeyValuePair<string, string>(a.AssetTypeName, a.AssetTypeName)).ToList();

    private List<KeyValuePair<string, string>> AssetBrandDropdown =>
        string.IsNullOrEmpty(selectedAssetType)
            ? new()
            : assetReportFilters.Brand
                .Where(o => o.AssetType == selectedAssetType)
                .Select(b => new KeyValuePair<string, string>(b.BrandName, b.BrandName)).ToList();

    private List<KeyValuePair<string, string>> AssetModelDropdown =>
        string.IsNullOrEmpty(selectedAssetBrand)
            ? new()
            : assetReportFilters.Model
                .Where(o => o.Brand == selectedAssetBrand)
                .Select(m => new KeyValuePair<string, string>(m.ModelName, m.ModelName)).ToList();

    // Report actions
    public async Task ViewReportData()
    {
        isLoading = true;
        totalItem = 0;
        showReport = true;

        try
        {
            if (SelectedOption == "Employeebtn")
            {
                var employeeFilterModel = new EmployeeFilterModel
                {
                    Company = selectedSourceCompanyCode,
                    Designation = selectedJobProfile,
                    ManagerName = selectedManager,
                    BranchOffice = selectedBranch,
                    Location = selectedLocation,
                    Skills = selectedSkills,
                    EmployeeStatus = selectedEmployeeStatus,
                    JoinDateStart = (joinDateStart.HasValue && joinDateEnd.HasValue) ? joinDateStart.Value : default,
                    JoinDateEnd = (joinDateStart.HasValue && joinDateEnd.HasValue) ? joinDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default,
                    ResignDateStart = (resignDateStart.HasValue && resignDateEnd.HasValue) ? resignDateStart.Value : default,
                    ResignDateEnd = (resignDateStart.HasValue && resignDateEnd.HasValue) ? resignDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default
                };

                responceDataOfEmployee = await client.GetFilteredEmployeeReport(employeeFilterModel);
            }
            else
            {
                var assetFilterModel = new AssetFilterModel
                {
                    Company = selectedSourceCompanyForAssetCode,
                    AssetType = selectedAssetType,
                    Brand = selectedAssetBrand,
                    Model = selectedAssetModel,
                    Status = allocationStatus == "Free" ? AllocationStatus.Free
                            : allocationStatus == "Allocated" ? AllocationStatus.Allocated
                            : null,
                    AquireDateStart = (aquireDateStart.HasValue && aquireDateEnd.HasValue) ? aquireDateStart.Value : default,
                    AquireDateEnd = (aquireDateStart.HasValue && aquireDateEnd.HasValue) ? aquireDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default,
                    DiscardDateStart = (discardDateStart.HasValue && discardDateEnd.HasValue) ? discardDateStart.Value : default,
                    DiscardDateEnd = (discardDateStart.HasValue && discardDateEnd.HasValue) ? discardDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default
                };

                responceDataOfAsset = await client.GetFilteredAssetReport(assetFilterModel);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    public void CloseReport() => showReport = false;

    public void ClearFilter()
    {
        showReport = false;
        selectedSourceCompanyCode = null;
        selectedJobProfile = null;
        selectedManager = null;
        selectedBranch = null;
        selectedLocation = null;
        selectedSkills = new();
        selectedEmployeeStatus = "All";
        joinDateStart = joinDateEnd = resignDateStart = resignDateEnd = null;
    }

    public void ClearAssetFilter()
    {
        showReport = false;
        selectedSourceCompanyForAssetCode = null;
        selectedAssetType = null;
        selectedAssetBrand = null;
        selectedAssetModel = null;
        allocationStatus = "All";
        aquireDateStart = aquireDateEnd = discardDateStart = discardDateEnd = null;
    }

    protected async Task ExportExcelReport()
    {
        if (SelectedOption == "Employeebtn")
        {
            var employeeFilterModel = new EmployeeFilterModel
            {
                Company = selectedSourceCompanyCode,
                Designation = selectedJobProfile,
                ManagerName = selectedManager,
                BranchOffice = selectedBranch,
                Location = selectedLocation,
                Skills = selectedSkills,
                EmployeeStatus = selectedEmployeeStatus,
                JoinDateStart = (joinDateStart.HasValue && joinDateEnd.HasValue) ? joinDateStart.Value : default,
                JoinDateEnd = (joinDateStart.HasValue && joinDateEnd.HasValue) ? joinDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default,
                ResignDateStart = (resignDateStart.HasValue && resignDateEnd.HasValue) ? resignDateStart.Value : default,
                ResignDateEnd = (resignDateStart.HasValue && resignDateEnd.HasValue) ? resignDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default
            };

            var bytes = await client.EmployeeExportToExcel(employeeFilterModel);
            var fileName = $"EmployeeReport_{DateTime.Now:yyyy-MM-dd_HH-mm-ss}.xlsx";
            var mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await using var ms = new MemoryStream(bytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, mimeType, ms.ToArray());
        }
        else
        {
            var assetFilterModel = new AssetFilterModel
            {
                Company = selectedSourceCompanyForAssetCode,
                AssetType = selectedAssetType,
                Brand = selectedAssetBrand,
                Model = selectedAssetModel,
                Status = allocationStatus == "Free" ? AllocationStatus.Free
                        : allocationStatus == "Allocated" ? AllocationStatus.Allocated
                        : null,
                AquireDateStart = (aquireDateStart.HasValue && aquireDateEnd.HasValue) ? aquireDateStart.Value : default,
                AquireDateEnd = (aquireDateStart.HasValue && aquireDateEnd.HasValue) ? aquireDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default,
                DiscardDateStart = (discardDateStart.HasValue && discardDateEnd.HasValue) ? discardDateStart.Value : default,
                DiscardDateEnd = (discardDateStart.HasValue && discardDateEnd.HasValue) ? discardDateEnd.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59) : default
            };

            var bytes = await client.AssetExportToExcel(assetFilterModel);
            var fileName = $"AssetReport_{DateTime.Now:yyyy-MM-dd_HH-mm-ss}.xlsx";
            var mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await using var ms = new MemoryStream(bytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, mimeType, ms.ToArray());
        }
    }

    private async Task PrintPDF()
    {
        if (SelectedOption == "Employeebtn")
            await JSRuntime.InvokeVoidAsync("printDiv", "printContent");
        else
            await JSRuntime.InvokeVoidAsync("printDiv", "printAssetContent");
    }

    private async Task OpenExportDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialogResult = await DialogService.Show<DialogTemplateExample_Dialog>("Export to", options).Result;

        if (dialogResult?.Data is not null)
        {
            if (dialogResult.Data.Equals("Excel"))
                await ExportExcelReport();
            else if (dialogResult.Data?.ToString() == "PDF")
                await PrintPDF();
        }
    }

    private Task OnSkillsChanged(IEnumerable<string> values)
    {
        selectedSkills = values.ToList();
        return Task.CompletedTask;
    }
