@page "/login"
@layout LoginLayout
@inject NavigationManager navigationManager
@inject IdentityAuthenticationStateProvider authStateProvider
@using Microsoft.AspNetCore.Components.Forms
@using AssetManagement.Client.States
@using AssetManagement.Dto.Auth

<div class="d-flex justify-content-center align-items-center vh-100 auth-bg">
    <div class="card borderd shadow-lg w-100" style="max-width: 500px; opacity:0.92;">
        <div class="card-body">
            <!-- Logo -->
            <div class="text-center mb-4">
                <img src="/assets/img/logo.png" alt="Logo" class="img-fluid mb-3" width="70" />
                <h3 class="mb-3">Sign In</h3>
            </div>

            <!-- Sign In Form -->
            <EditForm OnValidSubmit="OnSubmit" Model="loginParameters">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <!-- Email Input -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input id="email" type="email" @bind="loginParameters.UserEmail" class="form-control" placeholder="Enter your email" required />
                    <ValidationMessage For="@(() => loginParameters.UserEmail)" />
                </div>

                <!-- Password Input -->
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input id="password" type="password" @bind="loginParameters.Password" class="form-control" placeholder="Enter your password" required />
                    <ValidationMessage For="@(() => loginParameters.Password)" />
                </div>

                <!-- Remember Me -->
                <div class="form-check mb-3">
                    <input id="rememberMe" type="checkbox" class="form-check-input" @bind="loginParameters.RememberMe" />
                    <label class="form-check-label" for="rememberMe">Remember Me</label>
                </div>

                <!-- Sign In Button -->
                <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Signing In…" : "Sign In")
                </button>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="text-danger mt-2">@error</p>
                }
            </EditForm>

            <!-- Divider -->
            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1" />
                <span class="px-2 text-muted small">or</span>
                <hr class="flex-grow-1" />
            </div>

            <!-- Microsoft SSO Button -->
            <div>
                <button type="button"
                        class="btn btn-microsoft w-100 d-flex align-items-center justify-content-center gap-2"
                        @onclick="MicrosoftLogin"
                        aria-label="Sign in with Microsoft"
                        disabled="@_msLoading">
                    <span class="microsoft-icon" aria-hidden="true">
                        <!-- Microsoft 4-tile logo (SVG) -->
                        <svg width="20" height="20" viewBox="0 0 23 23" xmlns="http://www.w3.org/2000/svg" focusable="false">
                            <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                            <rect x="13" y="1" width="9" height="9" fill="#7FBA00" />
                            <rect x="1" y="13" width="9" height="9" fill="#00A4EF" />
                            <rect x="13" y="13" width="9" height="9" fill="#FFB900" />
                        </svg>
                    </span>
                    <span class="microsoft-label">@(_msLoading ? "Redirecting…" : "Continue with Microsoft")</span>
                </button>
            </div>

            <!-- Forgot Password and Signup Links -->
            <div class="text-center mt-3">
                <p class="mb-1">
                    <a href="forgetpassword" class="text-primary">Forgot Password?</a>
                </p>
                @if (userCount == 0)
                {
                    <p>
                        Don’t have an account? <a href="register" class="text-primary">Sign Up</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Microsoft SSO button */
    .btn-microsoft {
        background-color: #ffffff;
        color: #1f1f1f;
        border: 1px solid #dadce0;
        border-radius: .6rem;
        padding: .7rem 1rem;
        font-weight: 600;
        line-height: 1.2;
        transition: box-shadow .2s ease, transform .02s ease, background-color .2s ease, color .2s ease;
    }

        /* subtle hover and active states */
        .btn-microsoft:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }

        .btn-microsoft:active {
            transform: translateY(1px);
        }

        /* disabled state */
        .btn-microsoft:disabled {
            opacity: .7;
            cursor: not-allowed;
        }

        /* focus ring for keyboard users */
        .btn-microsoft:focus-visible {
            outline: 3px solid rgba(0, 120, 212, .35); /* Windows blue */
            outline-offset: 2px;
        }

    /* icon sizing + spacing */
    .microsoft-icon {
        display: inline-flex;
        width: 20px;
        height: 20px;
    }

    .microsoft-label {
        letter-spacing: .2px;
    }

    /* dark mode awareness */
    @@media (prefers-color-scheme: dark) {
        .btn-microsoft

    {
        background-color: #1f1f1f;
        color: #ffffff;
        border-color: #3a3a3a;
    }

    .btn-microsoft:hover {
        box-shadow: 0 2px 10px rgba(0,0,0,.35);
    }

    }

    /* Optional: compact text on very small screens */
    @@media (max-width: 360px) {
        .microsoft-label

    {
        font-size: .95rem;
    }

    }
</style>

@code {
    private LoginParameters loginParameters { get; set; } = new LoginParameters();
    private string error { get; set; }
    private int userCount = 1;
    private bool _showPassword;
    private bool _isSubmitting;
    private bool _msLoading;

    private async Task OnSubmit()
    {
        error = null;
        _isSubmitting = true;
        try
        {
            await authStateProvider.Login(loginParameters);
            navigationManager.NavigateTo("");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void MicrosoftLogin()
    {
        _msLoading = true; // brief visual cue until navigation occurs
        navigationManager.NavigateTo("api/Authorize/MicrosoftLogin", true);
    }

    protected override async Task OnInitializedAsync()
    {
        userCount = await authStateProvider.GetUserCount();
    }
}
