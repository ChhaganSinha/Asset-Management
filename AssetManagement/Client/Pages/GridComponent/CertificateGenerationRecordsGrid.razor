@using AssetManagement.Dto.Models;
@using GridBlazor
@using GridBlazor.Pages
@using GridShared
@using GridShared.Utility
@using Microsoft.Extensions.Primitives
@inject HttpClient HttpClient

@if (_task.IsCompleted)
{
    <div class="row">
        <div class="col-sm-12">
            <GridComponent @ref="Component" T="CertificateGenerationRecord" Grid="@_grid"></GridComponent>
        </div>
    </div>
}
else
{
    <div class="loader-container mt-4">
        <div class="loader-progress"></div>
    </div>
}

@code
{
    [Parameter]
    public int? EmployeeId { get; set; }

    private CGrid<CertificateGenerationRecord> _grid;
    private Task _task;
    private static GridComponent<CertificateGenerationRecord> Component;

    Action<IGridColumnCollection<CertificateGenerationRecord>> columns = c =>
    {
        c.Add(o => o.Id).SetWidth("50px").Css("table-bordered").Titled("SN.");
        c.Add(o => o.EmployeeName).SetWidth("140px").Css("table-bordered").Titled("Employee");
        c.Add(o => o.EmployeeId).SetWidth("80px").Css("table-bordered").Titled("Employee Id");
        c.Add(o => o.CompanyCode).SetWidth("80px").Css("table-bordered").Titled("Company");
        c.Add(o => o.TemplateName).Css("table-bordered").Titled("Template");
        c.Add(o => o.GeneratedFileName).Css("table-bordered").Titled("Generated File");
        c.Add(o => o.GeneratedOn).Format("{0:dd/MMM/yyyy}").SetWidth("120px").Css("table-bordered").Titled("Generated On");
        c.Add(o => o.GeneratedBy).SetWidth("140px").Css("table-bordered").Titled("Generated By");
    };

    protected override async Task OnParametersSetAsync()
    {
        string url = "odata/CertificateGenerationRecord";
        var query = new QueryDictionary<StringValues>();
        query.Add("grid-sorting", "GeneratedOn__1__1");

        if (EmployeeId.HasValue && EmployeeId.Value > 0)
        {
            var values = new string[] { $"EmployeeId__1__{EmployeeId.Value}" };
            query.Add("grid-filter", new StringValues(values));
        }

        var client = new GridODataClient<CertificateGenerationRecord>(HttpClient, url, query, false, "CertificateRecordGrid", columns, 10)
            .Sortable(true)
            .Filterable(true)
            .ClearFiltersButton(true)
            .SetStriped(true)
            .WithGridItemsCount()
            .SetExcelExport(true, true, "CertificateRecords.xlsx")
            .ChangePageSize(true)
            .EmptyText("No records available")
            .SetKeyboard(true)
            .Searchable(true, false, false);

        _grid = client.Grid;
        _task = client.UpdateGrid();
        await _task;
    }

    public async void RefreshGrid()
    {
        if (Component != null)
        {
            await Component.UpdateGrid();
        }
    }
}
